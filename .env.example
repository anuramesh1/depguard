# Copy to .env and fill in. .env is gitignored; never commit real values.

# Used by docker-compose.yml (local Postgres + pgvector). Pick any local password.
POSTGRES_PASSWORD=change-me

# Phase 1 needs no keys: OSV.dev is free and keyless.
# Later phases (add when you reach them):
# NVD_API_KEY=            # phase 2: free key from https://nvd.nist.gov/developers/request-an-api-key
# AWS_PROFILE=            # phase 2: Bedrock models via your local AWS profile
# LANGFUSE_PUBLIC_KEY=    # phase 5: observability
# LANGFUSE_SECRET_KEY=
