# Copy to .env and fill in. .env is gitignored; never commit real values.

# Used by docker-compose.yml (local Postgres + pgvector). Pick any local password.
POSTGRES_PASSWORD=change-me

# The app also reads POSTGRES_PASSWORD from this file (spring.config.import), for the local RAG store.

# OSV.dev, EPSS and CISA KEV are free and keyless. Bedrock (chat + embeddings) uses your AWS credentials:
# AWS_PROFILE=            # optional: which local AWS profile to use (export it in your shell)
# Phase 5, optional: traces to Langfuse Cloud (free Hobby plan). Project settings -> API keys.
# Without keys, tracing is off and everything else works. scripts/deploy.sh passes them to Lambda.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com    # US region: https://us.cloud.langfuse.com (LANGFUSE_BASE_URL also works)
# LANGFUSE_CAPTURE_CONTENT=false            # metadata only: no prompts, answers or pom contents in traces
